# 42 API credentials
# Get these from: https://profile.intra.42.fr/oauth/applications
# Used by fetch_42_projects.py (Client Credentials grant type)

FT_CLIENT_ID=u-s4t2ud-your-client-id-here
FT_CLIENT_SECRET=s-s4t2ud-your-client-secret-here

# ── Session cookies for projects.intra.42.fr (used by fetch_42_subjects.py) ──
# Extract from browser DevTools after logging into projects.intra.42.fr:
#   1. Open https://projects.intra.42.fr and log in
#   2. Open DevTools (F12) → Application → Cookies → projects.intra.42.fr
#   3. Copy these cookie values:

SESSION_COOKIE=your-_intra_42_session_production-value
USER_ID_COOKIE=your-user.id-value
CF_CLEARANCE_COOKIE=your-cf_clearance-value

# Note: Session cookies expire periodically and need to be refreshed.

# Keyword filter — applied to project name before fetching details.
# Comma-separated. Leave empty to fetch all projects.
# FT_KEYWORDS=python,dslr,leaffliction

# ── fetch_42_subjects.py options ──────────────────────────────────────────────

# Directory where PDFs and extracted text are stored (default: subjects/)
FT_SUBJECTS_DIR=subjects

# Path to the history JSON file (default: history.json)
FT_HISTORY_FILE=history.json

# ── fetch_42_projects.py options ─────────────────────────────────────────────

# Optional: override default output filename
# OUTPUT_FILE=projects.json
