# 42 API credentials
# Get these from: https://profile.intra.42.fr/oauth/applications
# For fetch_42_projects.py: grant type = Client Credentials
# For fetch_42_subjects.py: grant type = Authorization Code

FT_CLIENT_ID=u-s4t2ud-your-client-id-here
FT_CLIENT_SECRET=s-s4t2ud-your-client-secret-here

# Required for fetch_42_subjects.py (Authorization Code flow)
# Must match the redirect URI set on your OAuth app
FT_REDIRECT_URI=http://localhost

# Keyword filter — applied to project name + slug before fetching details.
# Comma-separated. Leave empty to fetch all projects.
# FT_KEYWORDS=python,dslr,leaffliction

# ── fetch_42_subjects.py options ──────────────────────────────────────────────

# Directory where PDFs and extracted text are stored (default: subjects/)
FT_SUBJECTS_DIR=subjects

# Path to the history JSON file (default: history.json)
FT_HISTORY_FILE=history.json

# ── fetch_42_projects.py options ─────────────────────────────────────────────

# Optional: override default output filename
# OUTPUT_FILE=projects.json

# Project list cache (used by fetch_42_projects.py)
# FT_CACHE_FILE=.cache_summaries.json
# FT_CACHE_TTL_HOURS=24
